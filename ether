#!/bin/bash
# Ether-branded host escape wrapper.
# Enters the host PID namespace and drops into a root shell on the host.

if [[ $EUID -ne 0 ]]; then
    echo "ether must be run as root, you can use 'sudo ether' in the admin container"
    exit 1
fi

# Drop a leading '--' if the caller included it, since nsenter treats that as
# its own separator and would otherwise try to execute '--' as a command.
if [[ "${1:-}" == "--" ]]; then
    shift
fi

if [[ $# -ne 0 ]]; then
    exec nsenter -t 1 -a -- "$@"
else
    exec nsenter -t 1 -a /opt/bin/bash
fi
